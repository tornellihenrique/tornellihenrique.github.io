---
import { profile, proof } from '../data/profile';
---

<section class="page hero">
  <div class="hero-copy">
    <p class="mono-label">{profile.role} · Unreal Engine 5 · C++</p>
    <h1 class="hero-title">{profile.headline}</h1>
    <p class="hero-summary">{profile.summary}</p>
    <div class="hero-actions">
      <a class="button button-primary" href="#work">See the work</a>
      <a class="button" href={profile.cv}>Download CV</a>
    </div>
  </div>

  <figure class="hero-sketch">
    <canvas
      id="motion-sketch"
      class="hero-canvas"
      tabindex="0"
      role="img"
      aria-label="Wireframe rifle moved by a live stack of procedural motion layers: offset, aim, idle, sway and recoil."
    ></canvas>
    <figcaption class="hero-sketch-footer">
      <span class="hero-sketch-hint">
        A live sketch of a procedural motion stack. Move to sway, click to fire, right-click to aim.
      </span>
      <span class="hero-sketch-controls">
        <button id="motion-fire" class="sketch-button" type="button">Fire</button>
        <button id="motion-aim" class="sketch-button" type="button">Aim</button>
      </span>
    </figcaption>
  </figure>

  <ul class="hero-proof">
    {proof.map((item) => (
      <li class="hero-proof-item">
        <span class="hero-proof-value">{item.value}</span>
        <span class="hero-proof-label">{item.label}</span>
      </li>
    ))}
  </ul>
</section>

<script>
  import { startMotionSketch } from '../scripts/motion/sketch';

  const canvas = document.querySelector<HTMLCanvasElement>('#motion-sketch');
  const fireButton = document.querySelector<HTMLButtonElement>('#motion-fire');
  const aimButton = document.querySelector<HTMLButtonElement>('#motion-aim');

  if (canvas && fireButton && aimButton) {
    startMotionSketch(canvas, { fireButton, aimButton });
  }
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    padding-top: clamp(32px, 6vw, 72px);
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: 20px;
    justify-content: center;
    min-width: 0;
  }

  .hero-title {
    font-size: clamp(40px, 6.2vw, 72px);
    font-weight: 800;
    font-stretch: 118%;
    letter-spacing: -0.02em;
    line-height: 1.02;
  }

  .hero-summary {
    max-width: 56ch;
    color: var(--muted);
    font-size: clamp(17px, 1.6vw, 19px);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .hero-sketch {
    margin: 0;
    min-width: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .hero-canvas {
    width: 100%;
    height: clamp(280px, 62vw, 460px);
    cursor: crosshair;
    touch-action: pan-y;
    user-select: none;
  }

  .hero-sketch-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 14px;
    border-top: 1px solid var(--line);
  }

  .hero-sketch-hint {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.45;
  }

  .hero-sketch-controls {
    display: flex;
    flex: none;
    gap: 8px;
  }

  .sketch-button {
    min-width: 58px;
    min-height: 40px;
    padding: 4px 10px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: transparent;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 13px;
    cursor: pointer;
    touch-action: none;
    user-select: none;
  }

  .sketch-button:hover,
  .sketch-button:active {
    border-color: var(--accent);
  }

  .hero-proof {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .hero-proof-item {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 16px;
    border-bottom: 1px solid var(--line);
  }

  .hero-proof-item:nth-child(odd) {
    border-right: 1px solid var(--line);
  }

  .hero-proof-item:nth-last-child(-n + 2) {
    border-bottom: 0;
  }

  .hero-proof-value {
    font-size: clamp(24px, 3vw, 32px);
    font-weight: 700;
    font-stretch: 112%;
    line-height: 1.15;
  }

  .hero-proof-label {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.35;
  }

  @media (min-width: 960px) {
    .hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      gap: 40px;
    }

    .hero-proof {
      grid-column: 1 / -1;
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .hero-proof-item,
    .hero-proof-item:nth-last-child(-n + 2) {
      border-bottom: 0;
    }

    .hero-proof-item:nth-child(odd) {
      border-right: 0;
    }

    .hero-proof-item:not(:last-child) {
      border-right: 1px solid var(--line);
    }
  }
</style>
