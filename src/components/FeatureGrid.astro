---
import { getCollection, type CollectionEntry } from 'astro:content';
import Clip from './Clip.astro';

interface Props {
  id: string;
  title: string;
  group: CollectionEntry<'work'>['data']['group'];
}

const { id, title, group } = Astro.props;
const entries = (await getCollection('work'))
  .filter((entry) => entry.data.group === group)
  .sort((a, b) => a.data.order - b.data.order);
const headingId = `${id}-title`;
---

<section id={id} class="page section" aria-labelledby={headingId}>
  <div class="section-heading">
    <h2 id={headingId} class="section-title">{title}</h2>
  </div>

  <ul class="feature-grid">
    {entries.map((entry) => (
      <li>
        <a class="feature" href={`/work/${entry.id}/`}>
          <span class="feature-media">
            {entry.data.preview && <Clip src={entry.data.preview} label={entry.data.title} />}
            {!entry.data.preview && entry.data.cover && (
              <img src={entry.data.cover} alt="" width="1280" height="720" loading="lazy" />
            )}
          </span>
          <span class="feature-body">
            <span class="feature-title">{entry.data.title}</span>
            <span class="feature-tagline">{entry.data.tagline}</span>
            <span class="label">{entry.data.role} · {entry.data.period}</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .feature-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px 20px;
  }

  .feature {
    display: flex;
    flex-direction: column;
    gap: 12px;
    text-decoration: none;
  }

  .feature-media {
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    background: var(--surface);
  }

  .feature-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.25s ease;
  }

  .feature:hover .feature-media img {
    transform: scale(1.02);
  }

  .feature-body {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .feature-title {
    font-family: var(--font-display);
    font-size: clamp(26px, 3vw, 32px);
    font-weight: 700;
    line-height: 1.15;
  }

  .feature:hover .feature-title {
    color: var(--accent);
  }

  .feature-tagline {
    font-size: 16px;
    line-height: 1.4;
  }

  @media (min-width: 760px) {
    .feature-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
