---
import { experience, profile } from '../data/profile';
---

<section id="experience" class="page section" aria-labelledby="experience-title">
  <div class="section-heading">
    <h2 id="experience-title" class="section-title">Experience</h2>
    <a class="section-note text-link" href={profile.cv}>Full CV</a>
  </div>
  <ul class="experience">
    {experience.map((item) => (
      <li class="experience-row">
        <span class="experience-period">{item.period}</span>
        <div class="experience-body">
          <h3 class="experience-role">{item.role}</h3>
          <p class="experience-company">{item.company}</p>
          <p class="experience-text">{item.text}</p>
          {item.links.length > 0 && (
            <p class="experience-links">
              {item.links.map((link) => (
                <a class="text-link" href={link.href}>{link.label}</a>
              ))}
            </p>
          )}
        </div>
      </li>
    ))}
  </ul>
</section>

<style>
  .experience-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4px;
    padding-block: 20px;
    border-bottom: 1px solid var(--line);
  }

  .experience-row:first-child {
    padding-top: 0;
  }

  .experience-period,
  .experience-company {
    color: var(--muted);
    font-size: 15px;
  }

  .experience-role {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 700;
    line-height: 1.2;
  }

  .experience-text {
    max-width: 78ch;
    margin-top: 8px;
    font-size: 16px;
  }

  .experience-links {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 16px;
    margin-top: 8px;
    font-size: 15px;
    font-weight: 500;
  }

  @media (min-width: 760px) {
    .experience-row {
      grid-template-columns: 120px minmax(0, 1fr);
      gap: 24px;
      align-items: baseline;
    }
  }
</style>
