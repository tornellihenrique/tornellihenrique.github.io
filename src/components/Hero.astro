---
import { facts, profile } from '../data/profile';
---

<section class="hero">
  <canvas
    id="motion-sketch"
    class="hero-canvas"
    tabindex="0"
    role="img"
    aria-label="Wireframe rifle moved by a live stack of procedural motion layers: offset, aim, idle, sway and recoil."
  ></canvas>

  <div class="page hero-overlay">
    <div class="hero-copy">
      <h1 class="hero-name">{profile.name}</h1>
      <p class="hero-role">{profile.role}</p>
      <p class="hero-stack">{profile.stack.join(' · ')}</p>
      <ul class="hero-facts">
        {facts.map((fact) => (
          <li>{fact.href ? <a href={fact.href}>{fact.text}</a> : fact.text}</li>
        ))}
      </ul>
      <div class="hero-actions">
        <a class="button button-primary" href="#games">See the work</a>
        <a class="button" href={profile.cv}>Download CV</a>
      </div>
    </div>

    <div class="hero-play">
      <p class="hero-hint">Move to sway. Click to fire. Right-click to aim.</p>
      <div class="hero-controls">
        <button id="motion-fire" class="sketch-button" type="button">Fire</button>
        <button id="motion-aim" class="sketch-button" type="button">Aim</button>
      </div>
    </div>
  </div>
</section>

<script>
  import { startMotionSketch } from '../scripts/motion/sketch';

  const canvas = document.querySelector<HTMLCanvasElement>('#motion-sketch');
  const fireButton = document.querySelector<HTMLButtonElement>('#motion-fire');
  const aimButton = document.querySelector<HTMLButtonElement>('#motion-aim');

  if (canvas && fireButton && aimButton) {
    startMotionSketch(canvas, { fireButton, aimButton });
  }
</script>

<style>
  .hero {
    position: relative;
    height: calc(100svh - 59px);
    min-height: 520px;
    overflow: hidden;
  }

  .hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    cursor: crosshair;
    touch-action: pan-y;
    user-select: none;
  }

  .hero::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(12 13 15 / 86%), transparent 50%);
    content: '';
    pointer-events: none;
  }

  .hero-overlay {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px;
    height: 100%;
    padding-block: clamp(20px, 4vh, 44px);
    pointer-events: none;
  }

  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .hero-name {
    font-family: var(--font-display);
    font-size: clamp(52px, 8vw, 104px);
    font-weight: 700;
    line-height: 0.95;
  }

  .hero-role {
    font-family: var(--font-display);
    font-size: clamp(24px, 3vw, 34px);
    font-weight: 600;
    line-height: 1.15;
  }

  .hero-stack {
    color: var(--muted);
    font-size: 17px;
  }

  .hero-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 20px;
    margin-top: 10px;
    color: var(--muted);
    font-size: 15px;
  }

  .hero-facts a {
    pointer-events: auto;
    text-decoration-color: var(--line);
    text-underline-offset: 3px;
  }

  .hero-facts a:hover {
    color: var(--text);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 16px;
    pointer-events: auto;
  }

  .hero-play {
    display: flex;
    flex: none;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
  }

  .hero-hint {
    color: var(--muted);
    font-size: 14px;
    text-align: right;
  }

  .hero-controls {
    display: flex;
    gap: 8px;
    pointer-events: auto;
  }

  .sketch-button {
    min-width: 58px;
    min-height: 40px;
    padding: 4px 12px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgb(12 13 15 / 70%);
    color: var(--text);
    font: inherit;
    font-size: 15px;
    font-weight: 500;
    cursor: pointer;
    touch-action: none;
    user-select: none;
  }

  .sketch-button:hover,
  .sketch-button:active {
    border-color: var(--accent);
  }

  @media (max-width: 760px) {
    .hero::after {
      background: linear-gradient(to top, rgb(12 13 15 / 94%) 30%, transparent 72%);
    }

    .hero-overlay {
      flex-direction: column;
      align-items: stretch;
      justify-content: flex-end;
      gap: 16px;
    }

    .hero-play {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      order: -1;
    }

    .hero-hint {
      text-align: left;
    }
  }
</style>
