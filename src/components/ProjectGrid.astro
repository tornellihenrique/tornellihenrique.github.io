---
import { projects } from '../data/profile';
import Clip from './Clip.astro';
---

<section id="projects" class="page section" aria-labelledby="projects-title">
  <div class="section-heading">
    <h2 id="projects-title" class="section-title">Projects and systems</h2>
  </div>

  <ul class="project-grid">
    {projects.map((project) => (
      <li>
        <a class="project" href={project.href}>
          {project.clip ? <Clip src={project.clip} label={project.title} /> : <span class="project-blank" />}
          <span class="project-caption">
            <span class="project-title">{project.title}</span>
            <span class="project-text">{project.text}</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }

  .project {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--surface);
    text-decoration: none;
  }

  .project-blank {
    display: block;
    aspect-ratio: 16 / 9;
  }

  .project-caption {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    display: flex;
    flex-direction: column;
    padding: 28px 10px 8px;
    background: linear-gradient(to top, rgb(12 13 15 / 88%), transparent);
  }

  .project-title {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 700;
    line-height: 1.15;
  }

  .project:hover .project-title {
    color: var(--accent);
  }

  .project-text {
    display: none;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.3;
  }

  @media (min-width: 640px) {
    .project-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .project-text {
      display: block;
    }
  }

  @media (min-width: 1040px) {
    .project-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
