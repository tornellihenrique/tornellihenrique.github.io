---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Clip from '../../components/Clip.astro';
import YouTube from '../../components/YouTube.astro';
import Base from '../../layouts/Base.astro';
import { profile } from '../../data/profile';

export async function getStaticPaths() {
  const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
  return work.map((entry, index) => ({
    params: { slug: entry.id },
    props: { entry, next: work[(index + 1) % work.length] },
  }));
}

interface Props {
  entry: CollectionEntry<'work'>;
  next: CollectionEntry<'work'>;
}

const { entry, next } = Astro.props;
const { title, tagline, group, period, role, stack, cover, notice, media, links } = entry.data;
const backTargets = {
  game: { href: '/#games', label: 'games' },
  plugin: { href: '/#plugins', label: 'plugins' },
  project: { href: '/#projects', label: 'projects' },
};
const { href: backHref, label: backLabel } = backTargets[group];
const { Content } = await render(entry);
---

<Base title={`${title} | ${profile.name}`} description={tagline} image={cover}>
  <article class="page case">
    <a class="case-back label" href={backHref}>Back to {backLabel}</a>
    <header class="case-header">
      <h1 class="case-title">{title}</h1>
      <p class="case-tagline">{tagline}</p>
      <p class="case-meta">{role}, {period}</p>
      <p class="case-meta">{stack.join(', ')}</p>
      {links.length > 0 && (
        <p class="case-links">
          {links.map((link) => (
            <a class="text-link" href={link.href}>{link.label}</a>
          ))}
        </p>
      )}
    </header>

    <ul class:list={['case-media', { 'case-media-grid': media.length > 2 }]}>
      {media.map((item) => (
        <li>
          <figure class="case-figure" id={item.type === 'clip' ? item.src.split('/').pop() : undefined}>
            {item.type === 'clip' && <Clip src={item.src} label={item.caption} />}
            {item.type === 'youtube' && <YouTube id={item.id} poster={item.poster} title={title} />}
            {item.type === 'image' && (
              <img src={item.src} alt={item.caption} width="1280" height="720" loading="lazy" />
            )}
            <figcaption class="case-caption">{item.caption}</figcaption>
          </figure>
        </li>
      ))}
    </ul>

    <div class="case-content">
      <Content />
      {notice && <p class="case-notice">{notice}</p>}
    </div>

    <a class="case-next" href={`/work/${next.id}/`}>
      <span class="label">Next</span>
      <span class="case-next-title">{next.data.title}</span>
    </a>
  </article>
</Base>

<style>
  .case {
    padding-top: 24px;
  }

  .case-back {
    text-decoration: none;
  }

  .case-header {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 28px;
    margin-bottom: 36px;
  }

  .case-title {
    font-family: var(--font-display);
    font-size: clamp(44px, 6.4vw, 76px);
    font-weight: 700;
    line-height: 1;
  }

  .case-tagline {
    max-width: 60ch;
    margin: 4px 0 10px;
    font-size: clamp(18px, 2vw, 21px);
    line-height: 1.4;
  }

  .case-meta {
    color: var(--muted);
    font-size: 15px;
  }

  .case-links {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 20px;
    margin-top: 6px;
    font-size: 15px;
  }

  .case-media {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  .case-figure {
    margin: 0;
  }

  .case-figure img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--surface);
  }

  .case-caption {
    margin-top: 6px;
    color: var(--muted);
    font-size: 14px;
  }

  .case-content {
    max-width: 72ch;
    margin-top: 48px;
  }

  .case-content :global(h2) {
    margin: 40px 0 8px;
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 700;
    line-height: 1.2;
  }

  .case-content :global(p) {
    margin-bottom: 16px;
    line-height: 1.7;
  }

  .case-content :global(p:first-child) {
    font-size: 19px;
  }

  .case-content :global(ul) {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 16px;
    padding-left: 20px;
    list-style: disc;
  }

  .case-content :global(li::marker) {
    color: var(--muted);
  }

  .case-content :global(a) {
    color: var(--accent);
    text-underline-offset: 3px;
  }

  .case-content :global(code) {
    font-size: 0.9em;
  }

  .case-notice {
    margin-top: 32px;
    padding: 14px 16px;
    border-left: 2px solid var(--accent);
    background: var(--surface);
    color: var(--muted);
    font-size: 15px;
  }

  .case-next {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-top: 56px;
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    text-decoration: none;
    transition: border-color 0.15s ease;
  }

  .case-next:hover {
    border-color: var(--accent);
  }

  .case-next-title {
    font-family: var(--font-display);
    font-size: clamp(26px, 3vw, 34px);
    font-weight: 700;
  }

  @media (min-width: 760px) {
    .case-media-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
