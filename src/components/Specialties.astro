---
import { specialties } from '../data/profile';
---

<section class="page section" aria-labelledby="specialties-title">
  <div class="section-heading">
    <h2 id="specialties-title" class="section-title">What I work on</h2>
  </div>
  <ul class="specialties">
    {specialties.map((item) => (
      <li class="specialty">
        <h3 class="specialty-title">{item.title}</h3>
        <p class="specialty-text">{item.text}</p>
        <p class="specialty-proof">
          {item.proof.map((link) => (
            <a class="text-link" href={link.href}>{link.label}</a>
          ))}
        </p>
      </li>
    ))}
  </ul>
</section>

<style>
  .specialties {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--line);
  }

  .specialty {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px;
    background: var(--bg);
  }

  .specialty-title {
    font-size: 20px;
    font-weight: 700;
  }

  .specialty-text {
    flex: 1;
    color: var(--muted);
    font-size: 15px;
  }

  .specialty-proof {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    font-family: var(--font-mono);
    font-size: 13px;
  }

  @media (min-width: 640px) {
    .specialties {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 960px) {
    .specialties {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
