---
import Base from '../layouts/Base.astro';
import { profile } from '../data/profile';
---

<Base title={`Page not found | ${profile.name}`} description="This page does not exist.">
  <section class="page not-found">
    <p class="mono-label">404</p>
    <h1 class="section-title">This page does not exist.</h1>
    <a class="button" href="/">Back to the start</a>
  </section>
</Base>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: flex-start;
    padding-top: 96px;
  }
</style>
